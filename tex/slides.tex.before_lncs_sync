\begin{frame}{問題設定}
  一つの学校における admissions を考える。
  \begin{itemize}
    \item 一般カテゴリ $o$ と複数の留保カテゴリ $T$
    \item 学生 $i$ は複数の留保カテゴリに同時に属しうる
    \item 各カテゴリには容量制約 $q^c$
    \item One-to-one counting:
    一人の合格者は最終的に一つのカテゴリにだけ数えられる
    \item 点数制約:
    一般カテゴリ cutoff と留保カテゴリ cutoff の差を抑えたい
  \end{itemize}
\end{frame}


\begin{frame}{モデル 1: 基本記号}
  学生集合 $I$，留保カテゴリ集合 $T$，一般カテゴリ $o$ を用いて
  \[
    V := T\cup\{o\}
  \]
  とする。

  各学生 $i\in I$ は
  \begin{itemize}
    \item 加点前スコア $\sigma(i)\in\R_+$
    \item 資格カテゴリ集合 $\T(i)\subseteq T$
    \item カテゴリ選好 $\succ_i$
  \end{itemize}
  を持つ。

  応募可能カテゴリ集合は
  \[
    V_i := \{o\}\cup \T(i).
  \]
\end{frame}

\begin{frame}{モデル 1.5: カテゴリ選好}
  各学生 $i$ は応募可能カテゴリ集合 $V_i$ 上に選好順序
  \[
    \succ_i
  \]
  を持つ。

  例えば
  \[
    t_2 \succ_i t_1 \succ_i o
  \]
  なら，
  学生 $i$ は一般カテゴリより留保カテゴリを好み，
  留保カテゴリの中では $t_2$ を $t_1$ より好む。

  PA-ODR ではこの選好を反映するため，
  後で preference rank
  \[
    r_i(c)
  \]
  を用いる。

  SPSE では $\succ_i$ に沿って応募先を順に選び，
  PA-ODR では複数の feasible な留保割当の間で
  $r_i(c)$ を使ってカテゴリ選好を比較する。
\end{frame}

\begin{frame}{モデル 2: 共通加点}
  全ての留保カテゴリに共通の bonus $k\ge 0$ を与える。

  カテゴリ $c$ における学生 $i$ の 加点後スコア を
  \[
    \sigma_c(i)=
    \begin{cases}
      \sigma(i) & c=o,\\[3pt]
      \sigma(i)+k\ & c=t\in T
    \end{cases}
  \]
  と定義する。

  \vspace{0.5em}
  解釈:
  \begin{itemize}
    \item 一般カテゴリでは 加点前スコア で比較
    \item 留保カテゴリでは共通加点後スコアで比較
    \item カテゴリごとに加点を変えることはしない
  \end{itemize}

  \vspace{0.5em}
  {\small 留保資格はスコア補正を与えるが，one-to-one counting の下ではカテゴリ割当が別途必要になる。}
\end{frame}

\begin{frame}{モデル 3: マッチング}
  マッチングを
  \[
    \mu=(\mu_c)_{c\in V}
  \]
  と書く。

  feasible とは
  \[
    |\mu_c|\le q^c \quad (\forall c\in V)
  \]
  かつ
  \[
    \mu_c\cap \mu_{c'}=\emptyset \quad (\forall c\neq c')
  \]
  を満たすこと。

  これは
  \begin{itemize}
    \item 容量制約
    \item one-to-one counting
  \end{itemize}
  を同時に表す。
\end{frame}

\begin{frame}{モデル 3.5: 容量ベクトル}
  元の制度で与えられる容量を
  \[
    q=(q^o,(q^t)_{t\in T})
  \]
  と書く。

  \begin{itemize}
    \item $q^o$: 一般カテゴリの容量
    \item $q^t$: 留保カテゴリ $t$ の容量
  \end{itemize}

  PA-ODR では de-reservation により容量を更新するので，
  反復中および最終的な有効容量を
  \[
    \hat q=(\hat q^o,(\hat q^t)_{t\in T})
  \]
  と書き，元の容量ベクトル $q$ と区別する。
\end{frame}

\begin{frame}{モデル 4: Score-feasibility}
  一般カテゴリ cutoff:
  \[
    e_o(\mu):=\min_{i\in\mu_o}\sigma(i)
  \]

  留保カテゴリ $t$ の adjusted cutoff:
  \[
    e_t^+(\mu):=\min_{i\in\mu_t}\sigma_t(i)
  \]

  許容ギャップ $\delta\ge 0$ の下で
  \[
    e_o(\mu)-e_t^+(\mu)\le \delta
  \]
  が全ての空ではない留保カテゴリで成立するとき，
  $\mu$ は score-feasible.

  \vspace{0.5em}
  {\small [Ayg\"un and Turhan, 2020; Ayg\"un and Turhan, 2023]}
\end{frame}

\begin{frame}{性質 1: Feasibility}
  マッチング $\mu$ が feasible であるとは，
  任意のカテゴリ $c\in V$ について
  \[
    |\mu_c|\le q^c
  \]
  を満たし，さらに任意の異なる $c,c'\in V$ について
  \[
    \mu_c\cap\mu_{c'}=\emptyset
  \]
  を満たすことをいう。

  \vspace{0.5em}
  すなわち，容量制約と one-to-one counting を同時に要求する。
\end{frame}

\begin{frame}{性質 2: Non-wastefulness}
  マッチング $\mu$ が non-wasteful であるとは，
  未マッチ学生 $i\in I\setminus M(\mu)$ とカテゴリ $c\in V_i$ について，
  $i$ をカテゴリ $c$ に追加したマッチング $\mu'$ が
  \[
    \text{feasible}
    \qquad\text{and}\qquad
    \text{score-feasible}
  \]
  になるような空き $c$ が存在しないことをいう。

  \vspace{0.5em}
  ここで
  \[
    \mu'_c=\mu_c\cup\{i\},
    \qquad
    \mu'_{c'}=\mu_{c'}\ \ (c'\neq c)
  \]
  とする。

  \vspace{0.5em}
  空きがあっても，追加により score-feasibility が満たされなくなるなら，
  その空きは浪費とはみなさない。

  {\small [Ehlers et al., 2014; Goto et al., 2017; Kurata et al., 2017]}
\end{frame}

\begin{frame}{性質 3: Within-Category Fairness}
  同じカテゴリの中では，
  \textbf{未割り当ての高得点者を残して低得点者を取らない}ことを要求する。

  \begin{definition}[Within-category fairness]
    $\mu$ が \textbf{within-category fair} であるとは，
    あるカテゴリ $c\in V$ と学生 $i,j$ について
    \[
      i\notin M(\mu),\qquad j\in\mu_c,\qquad c\in V_i,\qquad \sigma_c(i)>\sigma_c(j)
    \]
    を同時に満たす組が存在しないことをいう。
  \end{definition}

  \vspace{0.5em}
  つまり，各カテゴリで実際に割り当てられている最低得点者より高い学生が
  未割り当てのまま残ることを禁止する。
\end{frame}


