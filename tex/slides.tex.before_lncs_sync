\begin{frame}{SPSE の証明 1}
  \textbf{Feasibility}
  \begin{itemize}
    \item 各カテゴリは各段階で高々 $q^c$ 人しか保留しない
    \item 各学生は同時に高々1つのカテゴリでしか保留されない
    \item よって最終結果も容量制約と one-to-one counting を満たす
  \end{itemize}

  \vspace{0.4em}
  \textbf{Within-category fairness}
  \begin{itemize}
    \item もし未割当の $i$ と在籍者 $j\in\mu_c$ がいて $\sigma_c(i)>\sigma_c(j)$ なら，
    $i$ が $c$ に応募した時点で $j$ より優先される
    \item DA の保留集合は各時点でそのカテゴリの上位者だけを残すので，
    $j$ が最終的に残って $i$ が未割当になることはない
  \end{itemize}
\end{frame}

\begin{frame}{SPSE の証明 2}
  \textbf{Non-wastefulness}
  \begin{itemize}
    \item 最終的に未割当の学生 $i$ は，応募可能な全カテゴリに応募済みである
    \item もし $c\in V_i$ に空きがあれば，$i$ が $c$ に応募した時点で $c$ は $i$ を保留し続けるので，
    $i$ が未割当で終わることと矛盾
    \item よって未割当学生を単純追加して feasible かつ score-feasible にできる空席は存在しない
  \end{itemize}

  \vspace{0.4em}
  \textbf{Score-feasibility が満たされない理由}
  \begin{itemize}
    \item SPSE は各カテゴリで 加点後スコア 順に受け入れるだけで，
    open cutoff と reserved cutoff の差 $\,\delta\,$ を直接管理しない
    \item したがって最終的に $e_o(\mu)-e_t^+(\mu)>\delta$ となることがある
  \end{itemize}
\end{frame}

\begin{frame}{PA-ODR アルゴリズム}
score-feasibleを満たすために,以下のような動作のPA-ODRアルゴリズムを考える

  \begin{enumerate}
    \item 初期有効容量を $\hat q^o=q^o$, $\hat q^t=q^t$ で置く
    \item 一般カテゴリに 加点前スコア 上位 $\hat q^o$ 人を割り当てる
    \item open cutoff $e$ を計算する
    \item $E(e)$ を使って留保割当を構成する
    \item もし $|\mu_t|<\hat q^t$ の留保カテゴリがあれば
    \[
      \hat q^t\leftarrow \hat q^t-1,\qquad
      \hat q^o\leftarrow \hat q^o+1
    \]
    として反復する
    \item 全ての正の留保容量が埋まったら停止
  \end{enumerate}
\end{frame}

\begin{frame}{PA-ODR におけるカテゴリ選好の反映}
  人数もスコアも同じ留保割当が複数残ったとき，
  学生の希望にできるだけ近い方を選ぶ。

  \begin{block}{希望順位 $r_i(c)$：$i$ にとって $c$ が何番目の希望か（小さいほど良い）}
    第1希望なら $1$，第2希望なら $2$，\dots。\quad
    例）$t_2\succ_i t_1\succ_i o$ なら $r_i(t_2)=1,\ r_i(t_1)=2$。
  \end{block}

  留保割当の選び方：
  \begin{enumerate}
    \item まず，埋まる人数を最大にする
    \item その中で，加点後スコアをできるだけ高くする
    \item それでも並んだら，学生をできるだけ上の希望のカテゴリに入れる方を選ぶ
          （点数の高い学生の希望から優先して見る）
  \end{enumerate}
\end{frame}

\begin{frame}{なぜスコアが最大になるのか}
  留保割当は，同じ人数で埋められる候補の中から，
  「割り当てられた学生の加点後スコアを大きい順に並べた列」が
  いちばん大きいものを選んでいる（選び方の2段階目）。

  \vspace{0.5em}
  \begin{block}{カギ：高得点の学生に入れ替えると，列は必ず大きくなる}
    あるカテゴリ $c$ の在籍者 $j$ を，そのカテゴリにわりあてられてより高得点の $i$
    （$\sigma_c(i)>\sigma_c(j)$）に入れ替える。人数は変わらず，並びだけ上がる：
    \vspace{-0.4em}
    \[
      (\,\dots,\ \sigma_c(j),\ \dots\,)
      \ \longrightarrow\
      (\,\dots,\ \sigma_c(i),\ \dots\,).
    \]
  \end{block}

  \vspace{0.3em}
  例：$t_2$ に $92$ の学生が割り当てられているが，$t_2$ にわりあてられる $96$ の学生が余っている。
  \vspace{-0.3em}
  \[
    (\,96,\ \dots\,)\ >\ (\,92,\ \dots\,)\quad(\text{大きい順に比較})
  \]
  入れ替えた方が大きいので，最初からそちらが選ばれている。
\end{frame}

\begin{frame}{PA-ODR で評価する性質}
  PA-ODR でも基本的な性質の考え方は SPSE と同じである。

  \begin{itemize}
    \item feasibility
    \item non-wastefulness
    \item within-category fairness
    \item de-reservation-adjusted within-category fairness
    \item score-feasibility
  \end{itemize}

  ただし de-reservation により最終容量が決まるので，
  \begin{itemize}
    \item feasibility と non-wastefulness は最終容量 $\hat q$ に関して読む
    % \item PA-ODR は人数最大 $\to$ スコアベクトル辞書式最大の基準で，この fairness notion と整合的に選ぶ
    % \item score-feasibility は hard constraint として別に保証する
  \end{itemize}
\end{frame}


\begin{frame}{PA-ODR の性質 2: Non-wastefulness}
  PA-ODR では non-wastefulness 自体は SPSE と同じ考え方でよい。

  未割り当て学生 $i\in I\setminus M(\mu)$ と応募可能カテゴリ $c\in V_i$ に対し，
  $i$ を追加できる空き $c$ が存在しないことをいう。

  ただし，ここでの feasibility は元の $q$ ではなく
  de-reservation 後の最終容量 $\hat q$ に関するもの：
  \[
    |\mu_c|\le \hat q^c
  \]
  かつ任意の異なる $c,c'\in V$ について
  \[
    \mu_c\cap\mu_{c'}=\emptyset
  \]
  を満たす。
\end{frame}


\begin{frame}{PA-ODR の結果}
  \begin{center}
  \begin{tabular}{ll}
    \toprule
    性質 & 結果 \\
    \midrule
    Score-feasibility & 成立 \\
    Non-wastefulness $(\hat q)$ & 成立 \\
    De-reservation-adjusted within-category fairness & 成立 \\
    % 制約付き across-category fairness & 成立 \\
    % 強い stability & \textbf{一般には不成立} \\
    カテゴリ選好の反映 & 成立 \\
    % 容量再配分 & 成立 \\
    \bottomrule
  \end{tabular}
  \end{center}
\end{frame}

\begin{frame}{PA-ODR の証明 1}
  \textbf{Feasibility}
  \begin{itemize}
    \item open では 加点前スコア 上位 $\hat q^o$ 人だけを取る
    \item reserved では各 $t$ に高々 $\hat q^t$ 人だけを割り当てる
    \item 一人は open か reserved のどちらか一方で数えるので，最終結果は $\hat q$ に関して feasible
  \end{itemize}

  \vspace{0.4em}
  \textbf{Score-feasibility}
  \begin{itemize}
    \item open cutoff を $e$ とすると，reserved の候補辺は
    \[
      \sigma(i)+k\ge e-\delta
    \]
    を満たすときだけ張られる
    \item したがって割り当てられた全ての $i\in\mu_t$ について $\sigma_t(i)\ge e-\delta$
    \item ゆえに $e_t^+(\mu)\ge e-\delta$，すなわち $e_o(\mu)-e_t^+(\mu)\le\delta$
  \end{itemize}
\end{frame}

\begin{frame}{PA-ODR の証明 2}
  \textbf{Non-wastefulness}
  \begin{itemize}
    \item アルゴリズムは，全ての正の reserved 容量が埋まるまで de-reservation を続ける
    \item 停止時には，正の容量を持つ reserved カテゴリはすべて満席であり，
    open も定義上ちょうど $\hat q^o$ 人を取っている
    \item よって最終容量 $\hat q$ に関して空席はなく，未割当学生を単純追加できない
  \end{itemize}

  \vspace{0.4em}
  \textbf{De-reservation-adjusted within-category fairness}
  \begin{itemize}
    \item de-reservation 後の最終グラフ $G(e)$ 上で比較する
    \item reserved で未割当の $i$ と在籍者 $j\in\mu_t$ がいて，$(i,t),(j,t)\in G(e)$ かつ $\sigma_t(i)>\sigma_t(j)$ なら，
    $j$ を $i$ に置き換えても人数は同じで score-feasibility は満たされ，
    スコアベクトルは厳密に改善する
    \item これは辞書式最大性に反するので，そのような組は存在しない
  \end{itemize}
\end{frame}

