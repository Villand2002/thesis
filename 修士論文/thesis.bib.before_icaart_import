@article{MACKENZIE2022105511,
title = {Menu mechanisms},
journal = {Journal of Economic Theory},
volume = {204},
pages = {105511},
year = {2022},
issn = {0022-0531},
doi = {https://doi.org/10.1016/j.jet.2022.105511},
url = {https://www.sciencedirect.com/science/article/pii/S0022053122001016},
author = {Andrew Mackenzie and Yu Zhou},
keywords = {Menu mechanism, Strategy-proofness, Robust implementation},
abstract = {We investigate menu mechanisms: dynamic mechanisms where at each history, an agent selects from a menu of his possible assignments. We consider both ex-post implementation and full implementation for a strengthening of dominance that covers off-path histories, and provide conditions under which menu mechanisms provide these implementations of rules. Our results cover a variety of environments, including matching with contracts, labor markets, auctions, school choice, marriage, object allocation, and elections.}
}


